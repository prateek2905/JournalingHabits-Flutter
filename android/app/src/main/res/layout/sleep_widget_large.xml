<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"  android:scaleType="fitXY" android:contentDescription="@null"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" >
        <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/hours" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="40sp" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:fontFamily="sans-serif-condensed" android:textStyle="normal" android:maxLines="1" android:ellipsize="end" />
        <ImageView android:id="@+id/chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:scaleType="fitXY" android:contentDescription="@null"/>
        <TextView android:id="@+id/sub2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:fontFamily="sans-serif-condensed" android:textStyle="normal" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="6dp"/>
    </LinearLayout>
</FrameLayout>
